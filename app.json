{
  "expo": {
    "name": "تستاهل؟",
    "slug": "should-i-buy-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shouldIcon.png",
    "scheme": "shouldibuyit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/shouldIcon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/shouldIcon.png",
        "backgroundImage": "./assets/images/shouldIcon.png",
        "monochromeImage": "./assets/images/shouldIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dooom.shouldibuyit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1ff3afe-062e-4cbe-b5f8-76609d88b1b3"
      }
    }
  }
}
